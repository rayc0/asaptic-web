/*
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/geo
  Cache-Control: no-store

/*.html
  Cache-Control: no-cache

/zh/*
  Content-Language: zh-Hans
/zht/*
  Content-Language: zh-Hant
/pt/*
  Content-Language: pt-PT

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/.well-known/agent.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/standard/data/*.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

# Tender LISTING feed — the single public data source read by asaptic.com/tender,
# app.asaptic.com, radar.asaptic.com, go.asaptic.com and the iOS/Android builds.
# Had NO rule until 2026-07-26, so it fell through to the Pages default
# (max-age=0, must-revalidate, cf-cache-status: DYNAMIC) — every request from every
# consumer revalidated against origin. Updates land ~2x/day, so 5 minutes is still
# far fresher than the publish cadence while cutting origin hits sharply.
# Access-Control-Allow-Origin must stay: app/radar/go fetch this cross-origin.
/tender/rows.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *

/university/_TEMPLATE.html
  X-Robots-Tag: noindex, nofollow
