/*
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Proof Lab — client-side demo surface. Strict CSP scoped to this path only.
# script-src stays 'self' (no 'unsafe-inline') because the page's module script
# lives in ./app.mjs, not inline. style-src needs 'unsafe-inline' for the page's
# <style> block + inline style="width:.." bars. No CSP is set on /* so this adds,
# never weakens, the global HSTS/X-Frame-Options/nosniff/Referrer/Permissions.
/demo/proof-lab/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://asaptic.com; base-uri 'none'; form-action https://portal.asaptic.com https://asaptic.com

/geo
  Cache-Control: no-store

/*.html
  Cache-Control: no-cache

/zh/*
  Content-Language: zh-Hans
/zht/*
  Content-Language: zh-Hant
/pt/*
  Content-Language: pt-PT

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/.well-known/agent.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/standard/data/*.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

# Tender LISTING feed — the single public data source read by asaptic.com/tender,
# app.asaptic.com, radar.asaptic.com, go.asaptic.com and the iOS/Android builds.
# Had NO rule until 2026-07-26, so it fell through to the Pages default
# (max-age=0, must-revalidate, cf-cache-status: DYNAMIC) — every request from every
# consumer revalidated against origin. Updates land ~2x/day, so 5 minutes is still
# far fresher than the publish cadence while cutting origin hits sharply.
# Access-Control-Allow-Origin must stay: app/radar/go fetch this cross-origin.
/tender/rows.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *

# Syndication feeds (Atom/RSS) — pure function of tender/rows.json, rebuilt into
# the deploy root on every publish by asaptic_tender_refresh.sh (feeds/build_feeds.mjs).
# Without the correct Content-Type the .xml files fall through to the SPA and feed
# readers reject them. 300s mirrors rows.json (far fresher than the ~2x/day cadence).
# CORS open: agents + feed aggregators fetch cross-origin.
/feeds/*.atom.xml
  Content-Type: application/atom+xml; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *

/feeds/*.rss.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *

/university/_TEMPLATE.html
  X-Robots-Tag: noindex, nofollow
